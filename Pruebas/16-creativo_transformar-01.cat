=^.^= Este programa es una prueba de la instruccion transformar
=^.^= En este dependiendo del valor que tome un numero se transforma una variable a un tipo u otro 
Reino cambioConstante ~

Organismos
    num <- habita Oveja adopta 2 ~ 
    peligro <- habita Gato ~ 
~~
Nacimiento
    pulpo num
    plancton
        tentaculo 1 :
            num adopta transformar Gato ~
            peligro adopta vivo ~               =^.^= vivo corresponde a true
        tentaculo 2 :
            num adopta transformar Gato ~
            peligro adopta muerto ~
        cabeza
            rugirSerpiente("Algo no va bien...") ~
    delfin

    cortejo peligro
    atrae
        rugirSerpiente("A cambiado a un peligro.") ~ ~

    cortejo peligro
    atrae
        rugirSerpiente("A cambiado a un booleano") ~ ~

Muerte cambioConstante ~~