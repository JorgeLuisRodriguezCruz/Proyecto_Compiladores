=^.^= Este programa es una prueba de la instruccion creativa amenaza
=^.^= Menu interactuable usando amenaza
Reino maquinando ~

Comportamientos
    =^.^= Recibe un entero y retorna el nivel de peligro asociado
    entrenar obtener_peligro(Oveja nivel) peligro ~
    plancton
        pulpo nivel
        plancton
            tentaculo 1 :
                Perro minimo ~
            cabeza
                Perro maximo ~
        delfin
    delfin
    
    ritual principal(Serpiente respuesta ~ Oveja opcion) ~
    plancton
        rugirSerpiente("Como te sientes?") ~
        rugirSerpiente("1. bien") ~
        rugirSerpiente("2. debastado") ~ 
        rugirSerpiente("Elige una de las dos opciones:") ~

        =^.^= Se hace la cohercion de la respuesta
        respuesta adopta olerSerpiente() ~
        opcion adopta respuesta Camaleon Oveja ~

        =^.^= Se pasa la opcion a la funcion para obtener el peligro
        opcion adopta obtener_peligro(opcion) ~
        cortejo opcion clon minimo
        atrae
            rugirSerpiente("Eso me preocupa, llame al siguiente numero") ~
        repele
            rugirSerpiente("Me alegro que tengas un buen dia.") ~ ~
    delfin
~~
Nacimiento
    principal("", 0) ~

Muerte maquinando ~~
