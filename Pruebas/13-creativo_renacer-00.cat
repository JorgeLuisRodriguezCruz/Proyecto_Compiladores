=^.^= Este programa es una prueba de la instruccion renacer
=^.^= Se prueba contando la cantidad de numeros pares en un arreglo y al final se resetea el contador con renacer

Reino fenix ~

Organismos
    indice <- habita Oveja adopta 0 ~  
    contador <- habita Oveja adopta 0 ~  
    numeros <- habita Corral Oveja [4] adopta {[ 2, 3, 4, 6 ]} ~    =^.^= Arreglo de enteros
~~
Nacimiento
    =^.^= Recorremos arreglo
    tiburon indice presaclon 4 sangre
    plancton
        indice adopta Acariciar indice ~                   =^.^= Instruccion que incrementa en 1 al indice         
        cortejo numeros[indice] rat 2 clon 0
        atrae
            contador adopta Acariciar contador ~ ~
    delfin ~
    
    rugirSerpiente("El arreglo tiene esta cantidad de pares:") ~

    =^.^= Cohercion de entero a string
    rugirSerpiente(contador Camaleon Serpiente) ~

    =^.^= Esto deja al contador en un estado similar a ser re declaro
    renacer contador ~
    contador adopta 0 ~ 
Muerte fenix ~~
